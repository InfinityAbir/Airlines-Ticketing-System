# Protected IPFS upload endpoint (server/upload.js, R1 — decision D-05).
# No credentials are stored in this repo. Copy this file to server/.env (git-ignored)
# and fill in real values for live uploads; leave unset to run the demo without IPFS
# (the endpoint then answers 503 ipfs-not-configured and the frontend records a
# deterministic mock CID tagged `mock fallback`).
#
# Server bind (optional).
# HOST=127.0.0.1
# PORT=8787
#
# Provider contract: POST { IPFS_PROVIDER_URL } with
#   Content-Type: application/json
#   Authorization: Bearer <IPFS_API_KEY>
#   body: { "name": "<file name>.json", "content": "<raw metadata JSON string>" }
# expecting a JSON response containing the CID in one of: cid | hash | IpfsHash.
# IPFS_PROVIDER_URL=
# IPFS_API_KEY=
